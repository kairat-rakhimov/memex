# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# -----------------------------------------------------------------------------
# LLM API — required (any OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-your-key
# Leave unset for OpenAI; point at another OpenAI-compatible endpoint if needed.
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Models
# -----------------------------------------------------------------------------
# Chat tier: planning, query writing, extraction, answering.
MEMEX_CHAT_MODEL=gpt-4.1
# Reasoning tier: reading whole documents, mapping, reviewing, hypothesis work.
MEMEX_REASONING_MODEL=gpt-5.1
# Embeddings for entity resolution and semantic retrieval.
MEMEX_EMBEDDING_MODEL=text-embedding-3-large
MEMEX_EMBEDDING_DIMENSION=3072

# -----------------------------------------------------------------------------
# Public data sources
# -----------------------------------------------------------------------------
# Contact address or URL added to the User-Agent (Wikipedia's API policy asks
# for one) and used as the OpenAlex polite-pool `mailto` when it is an email.
MEMEX_CONTACT=

# Optional GROBID server for section-aware arXiv PDF parsing
# (`docker compose up -d grobid`, see docs/grobid.md). Unset → pdfminer.
# MEMEX_GROBID_URL=http://localhost:8070

# -----------------------------------------------------------------------------
# Build tuning
# -----------------------------------------------------------------------------
# Where graphs live: <MEMEX_KG_DIR>/<kg_id>/kg.db
MEMEX_KG_DIR=kg
# Override the demo-graph download used by `memex fetch-demo`.
# MEMEX_DEMO_URL=
# `session` (default) extracts each chunk with the whole document as a cached
# prompt prefix; `chunked` is the stateless fallback for very large documents.
MEMEX_EXTRACT_MODE=session
# Disk cache of fetched source documents under ./cache, so a stopped-and-resumed
# build doesn't re-download. 1 = on, 0 = off.
MEMEX_FETCH_CACHE=1

# -----------------------------------------------------------------------------
# HTTP API (`memex serve`) and trace UI (`memex ui`)
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
UI_PORT=8001
# Per-request timeout for POST /run, in seconds.
RUN_TIMEOUT_SECONDS=1800
LOG_DIR=logs
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Offline mode
# -----------------------------------------------------------------------------
# true → every LLM call returns a deterministic stub (no network to the LLM API).
# Source adapters still hit arXiv / Wikipedia / GDELT during a build.
SAMPLE_MODE=false
